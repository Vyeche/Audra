#!/bin/sh
# Registers the driver's source with DKMS and builds it for the running
# kernel. A failed build (no kernel headers, say) doesn't fail the install:
# it says what to do instead.
set -e

NAME=snd-usb-babyface-pro
VERSION=@VERSION@

case "$1" in
    configure)
        if ! dkms status -m "$NAME" -v "$VERSION" 2>/dev/null | grep -q .; then
            dkms add -m "$NAME" -v "$VERSION"
        fi
        if dkms install -m "$NAME" -v "$VERSION"; then
            echo "The Babyface driver is installed. Unplug and plug in the interface (or reboot) to load it."
        else
            echo "The Babyface driver could not be built for $(uname -r)." >&2
            echo "Install that kernel's headers (sudo apt install linux-headers-$(uname -r)), then run:" >&2
            echo "  sudo dkms install -m $NAME -v $VERSION" >&2
        fi
        ;;
esac

exit 0
